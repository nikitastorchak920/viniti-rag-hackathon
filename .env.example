# Скопируйте в .env и подставьте ключ (https://aistudio.google.com/apikey)
GEMINI_API_KEY=...
# Модель (по умолчанию gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
# Необязательно:
# GEMINI_MAX_RETRIES=6          # число повторов при 429/500/503/504/таймаутах
# GEMINI_BACKOFF_BASE=2         # базовая пауза, сек (экспонента + jitter)
# GEMINI_BACKOFF_MAX=60         # максимум паузы, сек
# GEMINI_TIMEOUT_S=300          # таймаут одного запроса, сек
# GEMINI_MAX_OUTPUT_TOKENS=65536
# GEMINI_TEMPERATURE=0

# Альтернатива Gemini (используется, если GEMINI_API_KEY не задан; только текст, сканы пропускаются)
# DEEPSEEK_API_KEY=...
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MAX_TOKENS=8192     # при обрезке ответа уменьшите --window
# DEEPSEEK_TIMEOUT_S=300
# DEEPSEEK_MAX_RETRIES=6
