# Copy to .env and set the key for your DeepSeek endpoint. Leave it empty for offline demos.
DEEPSEEK_API_KEY=
# Optional. Set HTTPS_PROXY in the process environment if required by your network.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_MAX_TOKENS=393216  # official limit. Use your gateway's supported cap instead.
# DEEPSEEK_TIMEOUT_S=300
# DEEPSEEK_MAX_RETRIES=6
# DEEPSEEK_BACKOFF_BASE=2
# DEEPSEEK_BACKOFF_MAX=60
